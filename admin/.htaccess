DirectoryIndex index.php
Options -Indexes
RewriteEngine On
RewriteBase /admin/
RewriteRule (^|/)\.env - [F,L]
RewriteRule ^(lib|database|config|migrations|tests|tools|app|vendor|node_modules)(/|$) - [F,L]
# admin/uploads is a symlink to ../uploads (see root .htaccess): the same
# private-document block has to be repeated here, since a request path of
# admin/uploads/secretary_documents/... never matches the root rule for
# uploads/secretary_documents/....
RewriteRule ^uploads/secretary_documents(/|$) - [F,L]
RewriteRule \.(md|lock|sql|bak)$ - [F,L,NC]
RewriteRule ^(composer\.json|package(-lock)?\.json|league-config\.json|htaccess-hub-original\.txt|render\.js)$ - [F,L,NC]
RewriteRule ^ - [L]
